       background: #f2f2f2; padding: 0 0.15em; }
pre { background: #f6f6f6; border: 1px solid #ddd; padding: 0.8em;
      overflow-x: auto; }
pre code { background: none; padding: 0; }
blockquote { border-left: 3px solid #9c9; margin-left: 0;
             padding-left: 1em; color: #444; }
table { border-collapse: collapse; }
th, td { border: 1px solid #bbb; padding: 0.25em 0.6em; }
th { background: #eee; }
.math { white-space: nowrap; }
.math.display { display: block; text-align: center; margin: 1em 0;
                white-space: normal; }
hr { border: none; border-top: 1px solid #bbb; }
</style>
</head>
